# SITE_URL: Required for production builds, prerendering canonicals, robots.txt sitemap reference, and sitemap.xml.
# Must be a live https:// root origin (placeholders such as *.example or localhost are rejected).
# Examples for GitHub Pages or a custom domain:
# SITE_URL="https://<your-github-username>.github.io"
# SITE_URL="https://numeriq.github.io"

