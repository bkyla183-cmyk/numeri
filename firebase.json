{
  "hosting": {
    "site": "numeriq",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/sitemap.xml/",
        "destination": "/sitemap.xml",
        "type": 301
      },
      {
        "source": "/post/:slug*",
        "destination": "/guide/:slug*",
        "type": 301
      },
      {
        "source": "/calculator/emi-calculator",
        "destination": "/calculator/loan-calculator",
        "type": 301
      },
      {
        "source": "/calculator/auto-loan-calculator",
        "destination": "/calculator/car-loan-calculator",
        "type": 301
      },
      {
        "source": "/calculator/bmr-calculator",
        "destination": "/calculator/calorie-calculator",
        "type": 301
      },
      {
        "source": "/calculator/calorie-deficit-calculator",
        "destination": "/calculator/calorie-calculator",
        "type": 301
      },
      {
        "source": "/calculator/weight-converter",
        "destination": "/calculator/unit-converter",
        "type": 301
      },
      {
        "source": "/calculator/temperature-converter",
        "destination": "/calculator/unit-converter",
        "type": 301
      },
      {
        "source": "/calculator/volume-converter",
        "destination": "/calculator/unit-converter",
        "type": 301
      },
      {
        "source": "/calculator/speed-converter",
        "destination": "/calculator/unit-converter",
        "type": 301
      },
      {
        "source": "/calculator/area-converter",
        "destination": "/calculator/unit-converter",
        "type": 301
      },
      {
        "source": "/calculator/percent-change-calculator",
        "destination": "/calculator/percentage-calculator",
        "type": 301
      },
      {
        "source": "/calculator/percent-of-number-calculator",
        "destination": "/calculator/percentage-calculator",
        "type": 301
      },
      {
        "source": "/calculator/savings-calculator",
        "destination": "/calculator/compound-interest-calculator",
        "type": 301
      },
      {
        "source": "/calculator/simple-interest-calculator",
        "destination": "/calculator/compound-interest-calculator",
        "type": 301
      },
      {
        "source": "/calculator/hysa-calculator",
        "destination": "/calculator/compound-interest-calculator",
        "type": 301
      },
      {
        "source": "/calculator/future-value-calculator",
        "destination": "/calculator/compound-interest-calculator",
        "type": 301
      },
      {
        "source": "/calculator/present-value-calculator",
        "destination": "/calculator/compound-interest-calculator",
        "type": 301
      },
      {
        "source": "/calculator/average-calculator",
        "destination": "/calculator/standard-deviation-calculator",
        "type": 301
      },
      {
        "source": "/calculator/mean-calculator",
        "destination": "/calculator/standard-deviation-calculator",
        "type": 301
      },
      {
        "source": "/calculator/variance-calculator",
        "destination": "/calculator/standard-deviation-calculator",
        "type": 301
      },
      {
        "source": "/calculator/profit-margin-calculator",
        "destination": "/calculator/gross-margin-calculator",
        "type": 301
      },
      {
        "source": "/calculator/markup-vs-margin-calculator",
        "destination": "/calculator/gross-margin-calculator",
        "type": 301
      },
      {
        "source": "/calculator/reverse-vat-calculator",
        "destination": "/calculator/vat-calculator",
        "type": 301
      },
      {
        "source": "/calculator/break-even-sales-calculator",
        "destination": "/calculator/break-even-calculator",
        "type": 301
      },
      {
        "source": "/calculator/high-school-gpa-calculator",
        "destination": "/calculator/gpa-calculator",
        "type": 301
      },
      {
        "source": "/calculator/exchange-rate-calculator",
        "destination": "/calculator/currency-converter",
        "type": 301
      },
      {
        "source": "/calculator/days-lived-calculator",
        "destination": "/calculator/age-calculator",
        "type": 301
      },
      {
        "source": "/calculator/lean-body-mass-calculator",
        "destination": "/calculator/body-fat-calculator",
        "type": 301
      },
      {
        "source": "/calculator/protein-intake-calculator",
        "destination": "/calculator/macronutrient-calculator",
        "type": 301
      },
      {
        "source": "/calculator/keto-macro-calculator",
        "destination": "/calculator/macronutrient-calculator",
        "type": 301
      },
      {
        "source": "/calculator/appliance-power-calculator",
        "destination": "/calculator/electricity-cost-calculator",
        "type": 301
      },
      {
        "source": "/calculator/vampire-power-calculator",
        "destination": "/calculator/electricity-cost-calculator",
        "type": 301
      },
      {
        "source": "/calculator/km-per-liter-converter",
        "destination": "/calculator/fuel-economy-converter",
        "type": 301
      },
      {
        "source": "/calculator/double-discount-calculator",
        "destination": "/calculator/discount-calculator",
        "type": 301
      },
      {
        "source": "/calculator/minimum-wage-calculator",
        "destination": "/calculator/hourly-to-salary-calculator",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      },
      {
        "source": "assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "404.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, follow"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/sitemap*.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/ads.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
